NODE_ENV=development

# web or worker; production workers do not require web-only secrets
AUTOPSY_SERVICE_ROLE=web

PORT=5100

DATABASE_URL=

# Optional Redis connection string. When set, it takes precedence over REDIS_HOST/REDIS_PORT.
REDIS_URL=

REDIS_HOST=localhost
REDIS_PORT=6379

REPOSITORY_STORAGE_PATH=./storage/repositories

MAX_REPOSITORY_SIZE_MB=500
MAX_ANALYSIS_TIME_MINUTES=30
MAX_ANALYZED_COMMITS=25000
EVIDENCE_RETENTION_DAYS=365

# Bounded API abuse protection. Heavy operations use the lower heavy limit.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_HEAVY_MAX_REQUESTS=12

# Required in production for runtime telemetry ingestion.
RUNTIME_TELEMETRY_INGEST_KEY=

# Required in production for deployment evidence ingestion.
DEPLOYMENT_EVIDENCE_INGEST_KEY=

# Temporary compatibility secret used only by the one-time legacy workspace migration.
AUTOPSY_API_ACCESS_KEY=

# Optional bootstrap operator account used for the initial migration of legacy workspaces.
AUTOPSY_BOOTSTRAP_EMAIL=
AUTOPSY_BOOTSTRAP_PASSWORD=

# Required only when private repository credentials are used.
# Generate 32 random bytes and encode them as 64 hexadecimal characters.
REPOSITORY_CREDENTIAL_ENCRYPTION_KEY=

# Optional in development/test; in production only these exact origins are allowed by CORS.
# Comma-separated exact origins, for example: https://app.example.com,https://admin.example.com
AUTOPSY_CORS_ORIGINS=

# Optional AI interpretation layer. The API key enables on-demand grounded interpretation.
AI_API_KEY=
AI_INTERPRETATION_CACHE_TTL_SECONDS=86400
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.7-flash
AI_LAST_RESORT_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=30000

# Optional transactional auth email. Configure all three together.
# Brevo is used for email verification and password reset delivery.
BREVO_API_KEY=
AUTOPSY_EMAIL_FROM=
AUTOPSY_EMAIL_FROM_NAME=Project Autopsy
AUTOPSY_PUBLIC_URL=https://project-autopsy.onrender.com
