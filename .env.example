NODE_ENV=development

# web or worker; production workers do not require web-only secrets
AUTOPSY_SERVICE_ROLE=web

PORT=5100

DATABASE_URL=

# Optional Redis connection string. When set, it takes precedence over REDIS_HOST/REDIS_PORT.
REDIS_URL=

REDIS_HOST=localhost
REDIS_PORT=6379

REPOSITORY_STORAGE_PATH=./storage/repositories

MAX_REPOSITORY_SIZE_MB=500
MAX_ANALYSIS_TIME_MINUTES=30

# Required in production for runtime telemetry ingestion.
RUNTIME_TELEMETRY_INGEST_KEY=

# Required in production for deployment evidence ingestion.
DEPLOYMENT_EVIDENCE_INGEST_KEY=

# Required in production for all API access.
AUTOPSY_API_ACCESS_KEY=

# Optional in development/test; in production only these origins receive credentialed CORS access.
# Comma-separated exact origins, for example: https://app.example.com,https://admin.example.com
AUTOPSY_CORS_ORIGINS=

# Optional AI interpretation layer. The API key enables on-demand grounded interpretation.
AI_API_KEY=
AI_INTERPRETATION_ACCESS_KEY=
AI_INTERPRETATION_CACHE_TTL_SECONDS=86400
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna
AI_TIMEOUT_MS=30000
