{
  "name": "project-autopsy",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed development history analyzer for software projects.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/analysis.worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/analysis.worker.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^6.3.9",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "simple-git": "^4.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}